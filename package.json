{
  "name": "zaijia-autopilot-hq",
  "version": "1.0.0",
  "description": "A multilingual, approval-gated automation service factory for small business operations.",
  "license": "Apache-2.0",
  "keywords": [
    "ai-automation",
    "multi-industry",
    "operations",
    "open-source",
    "self-hosted"
  ],
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/validate-env.mjs && next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/run-e2e.mjs",
    "worker": "node scripts/validate-env.mjs && tsx scripts/worker.ts",
    "worker:once": "tsx scripts/worker.ts --once",
    "worker:drain": "tsx scripts/drain-worker.ts",
    "digest": "tsx scripts/daily-digest.ts",
    "seed": "tsx scripts/seed-demo.ts",
    "smoke": "tsx scripts/smoke.ts",
    "backup": "tsx scripts/backup.ts",
    "restore-check": "tsx scripts/restore-check.ts",
    "security:secrets": "tsx scripts/secret-scan.ts",
    "showcase:verify": "node scripts/verify-showcase.mjs",
    "validate:env": "node scripts/validate-env.mjs",
    "verify": "pnpm security:secrets && pnpm showcase:verify && pnpm typecheck && pnpm test && pnpm build && pnpm smoke && pnpm restore-check"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "next": "16.2.10",
    "pino": "10.3.1",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "tsx": "4.23.9",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
