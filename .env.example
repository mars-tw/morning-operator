# Runtime
NODE_ENV=development
AUTOPILOT_DB_PATH=var/data/autopilot.db
AUTOPILOT_BASE_URL=http://localhost:3000
AUTOPILOT_AI_MODE=mock
NEXT_PUBLIC_DEFAULT_LOCALE=en
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_OFFER_CURRENCY=USD
NEXT_PUBLIC_OFFER_SETUP_MINOR=65000
NEXT_PUBLIC_OFFER_MONTHLY_MINOR=6500
# Minor units follow the payment provider/ISO currency exponent. Example: USD 650.00 = 65000.

# Owner login. Production refuses the demo password.
ADMIN_PASSWORD=demo-only-change-me
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters

# Hosted checkout; leave blank until the merchant account is approved.
NEXT_PUBLIC_CHECKOUT_URL=
LEMON_SQUEEZY_WEBHOOK_SECRET=

# Optional notification and monitoring adapters.
RESEND_API_KEY=
OPERATOR_EMAIL=
OPERATOR_FROM_EMAIL=早安店長 <notifications@example.com>
OPERATOR_TIME_ZONE=UTC
SENTRY_DSN=

# Approved Codex execution only.
CODEX_MODEL=
CODEX_TIMEOUT_MS=900000
